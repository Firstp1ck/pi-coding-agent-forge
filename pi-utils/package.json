{
  "name": "@firstpick/pi-utils",
  "version": "0.3.1",
  "description": "Shared utilities for Firstpick Pi extension packages.",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./paths": "./src/paths.ts",
    "./env": "./src/env.ts",
    "./text": "./src/text.ts",
    "./tokens": "./src/tokens.ts",
    "./prompt-calibration": "./src/prompt-calibration.ts",
    "./prompt-export-estimate": "./src/prompt-export-estimate.ts",
    "./initial-prompt-estimate-state": "./src/initial-prompt-estimate-state.ts",
    "./initial-prompt-estimate-service": "./src/initial-prompt-estimate-service.ts",
    "./async": "./src/async.ts",
    "./cli": "./src/cli.ts",
    "./json": "./src/json.ts",
    "./http": "./src/http.ts",
    "./hash": "./src/hash.ts",
    "./filesystem": "./src/filesystem.ts",
    "./time": "./src/time.ts",
    "./process": "./src/process.ts",
    "./git": "./src/git.ts",
    "./tool-result": "./src/tool-result.ts",
    "./markdown": "./src/markdown.ts",
    "./release-log": "./src/release-log.ts",
    "./ui": "./src/ui/working-indicator.ts",
    "./ui/live-output": "./src/ui/live-output.ts",
    "./local-wiki": "./src/local-wiki.ts",
    "./resource-management": "./src/resource-management.mjs",
    "./tui-resource-selector": "./src/tui-resource-selector.mjs",
    "./tui-model-profile-selector": "./src/tui-model-profile-selector.mjs",
    "./scoped-resource-command": "./src/scoped-resource-command.mjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/Firstp1ck/pi-coding-agent-forge/tree/main/pi-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firstp1ck/pi-coding-agent-forge.git",
    "directory": "pi-utils"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "utility"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "npm test",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/initial-prompt-estimate-state.test.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/reusable-utils.test.mjs && node tests/resource-management.test.mjs && node tests/tui-setup-option-selector.test.mjs && node tests/scoped-resource-command.test.mjs && node tests/tui-resource-selector.test.mjs && node tests/tui-model-profile-selector.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ]
}
