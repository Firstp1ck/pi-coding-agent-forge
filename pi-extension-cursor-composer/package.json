{
  "name": "@firstpick/pi-extension-cursor-composer",
  "version": "0.1.8",
  "description": "Pi extension and custom model provider for Cursor SDK Composer 2.5.",
  "license": "MIT",
  "homepage": "https://github.com/Firstp1ck/pi-coding-agent-forge/tree/main/pi-extension-cursor-composer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firstp1ck/pi-coding-agent-forge.git",
    "directory": "pi-extension-cursor-composer"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "cursor",
    "composer"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "check:upstream": "node scripts/check-cursor-sdk-upstream.mjs",
    "smoke:cursor": "node --import tsx scripts/cursor-usage-smoke.ts",
    "benchmark:cursor": "node --import tsx scripts/cursor-truncation-benchmark.ts"
  },
  "dependencies": {
    "@connectrpc/connect-node": "^2.1.2",
    "@cursor/sdk": "1.0.20",
    "@firstpick/pi-utils": "^0.2.4"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "files": [
    "index.ts",
    "context.ts",
    "README.md",
    "LICENSE"
  ]
}
